# Build output
bin/
obj/
*.user

# Deployment secrets (see .env.example for the expected keys)
.env

# Node deps for rig/ scripts (npm install, not committed)
rig/node_modules/

# Game install + steamcmd (74 GB, managed by steamcmd - never stage)
rig/server/
rig/steamcmd/

# Regenerable extraction/render artifacts
data/*.s2geo
data/*.glb
data/*.png
data/*.bin
data/*.nav
data/*.entities.json
data/*.navareas.json
# Derived from the .s2geo + nav mesh by the standspots build step; large and
# regenerable, so it ships to the server by rsync like the rest of data/.
data/*.standspots.json
data/*.viewer-map.json
# Pro-demo derived data - regenerated by rig/gather-pro-demos.sh, rsynced to
# the server like the other bind-mounted data rather than committed.
data/*.prosmokes.json
data/*.protargets.json
# meshdiff CLI output (physics-vs-render mismatch overlay) - regenerable, and
# its build cache (a raw VRF render-mesh export, hundreds of MB) already
# lives under data/cache/ below.
data/*.meshdiff.json
data/cache/
data/previews/

# Python bytecode (rig/ calibration scripts)
__pycache__/
*.pyc

# High-volume capture telemetry (rotated, regenerable from live runs)
data/calib/captures*.jsonl

# Live IPC mailbox files (transient protocol state)
data/calib/request.json
data/calib/*-request.json
data/calib/stop-request
data/calib/request.json.bad

# Tracked on purpose (hand-made calibration ground truth):
#   data/calib/markers.json
#   data/throws.json
#   data/throw-constants.json
#   data/validation/
data/calib/rig.log
data/calib/watcher.heartbeat
data/gather-pro-demos.log
data/gather-hltv-browser.log

# Map onboarding / re-extraction transcripts: tens of megabytes of console
# output, useful while a run is in flight and never afterwards.
data/onboard-logs/
data/reextract-logs/

# Account data. The session secret signs every login cookie - committing it
# would let anyone mint sessions - and the per-user files are people's saved
# lineups, not code. Both live in the bind-mounted data/ on prod.
data/session.secret
data/users/

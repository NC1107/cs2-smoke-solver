<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- serve hosts an ASP.NET Core minimal API; the shared framework ships
         with the SDK, so this pulls nothing from NuGet. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Sim\SmokeSolver.Sim.csproj" />
    <ProjectReference Include="..\Extraction\SmokeSolver.Extraction.csproj" />
    <ProjectReference Include="..\Solver\SmokeSolver.Solver.csproj" />
    <!-- Used directly by ViewerData's radar renderer; pinned to the version
         ValveResourceFormat expects so the transitive graph cannot drift. -->
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
    <!-- Used directly by MeshDiff to read back VRF's raw GLB render-mesh
         export (the actual GLB parser is this library, not bespoke code);
         pinned to the version ValveResourceFormat's own exporter expects. -->
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <!-- Votes. A vote is a read-modify-write against a shared record from a
         multi-threaded server; the temp-then-rename pattern the rest of the data
         uses gives atomic writes, not atomic cycles. A UNIQUE constraint does. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
